{
    "name": "noburi/send-laravel",
    "description": "Noburi Send for Laravel: a mail transport, a facade and webhook events.",
    "keywords": ["noburi", "noburi-send", "laravel", "mail", "email", "transactional", "webhooks"],
    "homepage": "https://send.noburi.space",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "noburi/send-php": "^0.2",
        "symfony/mailer": "^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Noburi\\Send\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noburi\\Send\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noburi\\Send\\Laravel\\NoburiSendServiceProvider"
            ],
            "aliases": {
                "NoburiSend": "Noburi\\Send\\Laravel\\Facades\\NoburiSend"
            }
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
